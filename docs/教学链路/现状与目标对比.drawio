<mxfile host="app.diagrams.net"><diagram id="d1" name="现状与目标对比"><mxGraphModel dx="1200" dy="640" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="640" background="#faf9fd" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#191524&quot;&gt;&lt;/font&gt;&lt;/b&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e7e3f0;arcSize=3;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="560" height="600" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#191524&quot;&gt;&lt;/font&gt;&lt;/b&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e7e3f0;arcSize=3;" vertex="1" parent="1"><mxGeometry x="620" y="20" width="560" height="600" as="geometry"/></mxCell><mxCell id="c4" value="现状：各环节相互独立" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=18;fontColor=#191524;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="44" y="38" width="520" height="24" as="geometry"/></mxCell><mxCell id="c5" value="依据知识体系备课；图谱、任务、测评之间没有连接" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#8e88a1;" vertex="1" parent="1"><mxGeometry x="44" y="64" width="520" height="18" as="geometry"/></mxCell><mxCell id="c6" value="目标：以全景图谱为坐标系串成闭环" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=18;fontColor=#5b3fd6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="644" y="38" width="520" height="24" as="geometry"/></mxCell><mxCell id="c7" value="每个环节的产出都挂在图谱节点上，结论只来自评价记录" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#8e88a1;" vertex="1" parent="1"><mxGeometry x="644" y="64" width="520" height="18" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#191524&quot;&gt;知识体系&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#8e88a1&quot;&gt;教什么&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d9d4e6;" vertex="1" parent="1"><mxGeometry x="44" y="110" width="140" height="56" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#191524&quot;&gt;工作台备课&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#8e88a1&quot;&gt;按内容生成&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d9d4e6;" vertex="1" parent="1"><mxGeometry x="236" y="110" width="140" height="56" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#191524&quot;&gt;课件 / 教案&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#8e88a1&quot;&gt;不挂节点&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d9d4e6;" vertex="1" parent="1"><mxGeometry x="428" y="110" width="128" height="56" as="geometry"/></mxCell><mxCell id="c11" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#6b6680;strokeWidth=1.5;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#6b6680;strokeWidth=1.5;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="✕ 只回答「教什么」，不回答「为什么教、教到什么程度」" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#c0392b;" vertex="1" parent="1"><mxGeometry x="44" y="178" width="512" height="22" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#191524&quot;&gt;全景图谱&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5c5670&quot;&gt;知识体系 × 能力图谱&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#8e88a1&quot;&gt;AI 可不断延展&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#f5f4f8;strokeColor=#d9d4e6;" vertex="1" parent="1"><mxGeometry x="44" y="222" width="230" height="74" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#191524&quot;&gt;备课 · 任务 · 评价&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5c5670&quot;&gt;延展的内容没有进入教学&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#f5f4f8;strokeColor=#d9d4e6;" vertex="1" parent="1"><mxGeometry x="340" y="222" width="216" height="74" as="geometry"/></mxCell><mxCell id="c16" value="✕" style="html=1;rounded=0;endArrow=none;dashed=1;strokeColor=#c0392b;strokeWidth=1.4;fontColor=#c0392b;fontSize=12;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#191524&quot;&gt;发布任务 / 学生提交&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5c5670&quot;&gt;平台已支持&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#f5f4f8;strokeColor=#d9d4e6;" vertex="1" parent="1"><mxGeometry x="44" y="326" width="230" height="74" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#191524&quot;&gt;技能 / 能力&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5c5670&quot;&gt;提交结果无法汇总&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#f5f4f8;strokeColor=#d9d4e6;" vertex="1" parent="1"><mxGeometry x="340" y="326" width="216" height="74" as="geometry"/></mxCell><mxCell id="c19" value="✕" style="html=1;rounded=0;endArrow=none;dashed=1;strokeColor=#c0392b;strokeWidth=1.4;fontColor=#c0392b;fontSize=12;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#191524&quot;&gt;能力测评&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5c5670&quot;&gt;评「课程能不能教到」&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#f5f4f8;strokeColor=#d9d4e6;" vertex="1" parent="1"><mxGeometry x="44" y="430" width="230" height="74" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#191524&quot;&gt;实际教学与学习&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5c5670&quot;&gt;实际教了什么、学会了什么&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#f5f4f8;strokeColor=#d9d4e6;" vertex="1" parent="1"><mxGeometry x="340" y="430" width="216" height="74" as="geometry"/></mxCell><mxCell id="c22" value="✕" style="html=1;rounded=0;endArrow=none;dashed=1;strokeColor=#c0392b;strokeWidth=1.4;fontColor=#c0392b;fontSize=12;" edge="1" parent="1" source="c20" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#191524&quot;&gt;&lt;/font&gt;&lt;/b&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#fdf3f2;strokeColor=#f3d2ce;" vertex="1" parent="1"><mxGeometry x="44" y="530" width="512" height="68" as="geometry"/></mxCell><mxCell id="c24" value="· 老师不按标准课程上课时，系统里没有「实际怎么教」的记录" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#5c5670;" vertex="1" parent="1"><mxGeometry x="62" y="538" width="480" height="24" as="geometry"/></mxCell><mxCell id="c25" value="· 学生看不到每次课的目标，也看不到自己在能力上的进展" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#5c5670;" vertex="1" parent="1"><mxGeometry x="62" y="562" width="480" height="24" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#191524&quot;&gt;授课计划&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#8e88a1&quot;&gt;课次 = 节点 + 目标等级&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#f1edfd;strokeColor=#5b3fd6;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="648" y="112" width="150" height="62" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#191524&quot;&gt;按课次备课&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#8e88a1&quot;&gt;资源挂节点&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#f1edfd;strokeColor=#5b3fd6;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="836" y="112" width="150" height="62" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot; color=&quot;#191524&quot;&gt;发布任务&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#8e88a1&quot;&gt;带节点与评价依据&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#f1edfd;strokeColor=#5b3fd6;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="1024" y="112" width="134" height="62" as="geometry"/></mxCell><mxCell id="c29" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#5b3fd6;strokeWidth=1.6;" edge="1" parent="1" source="c26" target="c27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#5b3fd6;strokeWidth=1.6;" edge="1" parent="1" source="c27" target="c28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value="&lt;b&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#ffffff&